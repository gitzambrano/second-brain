__pycache__/
*.code-workspace
.miktex/

# .claude/skills/ e .claude/agents/ são espelhos gerados de .agents/ (scripts/sync_skills.py).
# Apenas .claude/settings.json é versionado.
.claude/*
!.claude/settings.json
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/

# The two nested repositories are intentionally invisible to the outer engine Git.
/data/
/site/

# Legacy personal-data locations must never be reintroduced into the public engine.
/wiki/
/plan/
/raw/
/output/
/.obsidian/

# Local semantic-search caches
.qmd-cache/
.qmd-config/
.qmd-output/

# Python/test tooling
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
playwright-report/
test-results/

# OS/editor
.DS_Store
Thumbs.db

