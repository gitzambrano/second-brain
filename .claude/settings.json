{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/sync_skills.py\" --quiet",
            "statusMessage": "Sincronizando skills (.agents -> .claude)",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
